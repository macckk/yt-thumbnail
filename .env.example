# Copie para .env e ajuste. O arquivo .env NÃO vai para o git.

# Caminho alternativo para o arquivo de configuração (padrão: ./config.yaml)
# YT_THUMBNAIL_CONFIG=config.yaml

# Cache dos modelos do Hugging Face (SDXL ~7 GB, Whisper ~3 GB).
# Útil para colocar os modelos num disco com mais espaço.
# HF_HOME=D:/hf-cache

# Token do Hugging Face (opcional; o SDXL base é público).
# HF_TOKEN=
